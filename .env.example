# Copy to .env after setup. Never commit .env.
APP_ENV=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=
# PostgreSQL supplied by Supabase Connect. Use the direct connection when IPv6
# is available, or the Session pooler on port 5432 for IPv4-only backends.
# Replace every placeholder locally. Never commit the completed value.
DATABASE_URL=postgresql://backend_role:replace-locally@database.example.invalid:5432/postgres?sslmode=require
# For local SQLite development instead, use this explicit repository-relative URL:
# DATABASE_URL=sqlite+aiosqlite:///./runtime/db/sahay.db
# Prefer a separate direct/migration-safe connection for Alembic when available.
MIGRATION_DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_COMMAND_TIMEOUT_SECONDS=30
# Remote demo seeding is denied unless these remain private and all seed gates pass.
SUPABASE_PROJECT_REF=
REMOTE_DEMO_SEED_CONFIRMATION=
SAHAY_REMOTE_DEMO_SEED=0
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
ASSESSMENT_RUNNER=local
POLICY_RETRIEVER=local
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
AUDIO_STORAGE_PATH=./runtime/audio
AUDIO_RETENTION_HOURS=72
DATA_ROOT=
ASR_MODEL_PATH=
TTS_MODEL_PATH=
SER_MODEL_PATH=
CLASSIFIER_MODEL_PATH=
VAD_MODEL_PATH=
VAD_SILENCE_MS=700
AUDIO_FRAME_MS=500
TURN_LATENCY_TARGET_MS=3000
SVI_CONFIDENCE_FLOOR=0.45
# Task 5D-L: PROVISIONAL, UNREVIEWED candidate fixed scripts (S0/S9/SH/SX), text only.
# Local demo only. Keep false. Startup refuses true unless APP_ENV is development or test.
PROVISIONAL_FIXED_SCRIPTS_LOCAL_DEMO=false
FRONTEND_ORIGIN=http://localhost:5173
MOBILE_API_URL=
