        <mxCell id="s3" value="&lt;b&gt;&lt;font face=&quot;Courier New&quot;&gt;taken_over&lt;/font&gt;&lt;/b&gt;&lt;br&gt;assistant muted" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF1F8;strokeColor=#1F4E79;strokeWidth=1.5;fontSize=11;fontColor=#12314B;verticalAlign=middle;align=center;" vertex="1" parent="1">
