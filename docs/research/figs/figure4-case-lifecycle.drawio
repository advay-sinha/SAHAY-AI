        <mxCell id="a2" value="&lt;b&gt;confirm / modify / reject&lt;/b&gt;&lt;br&gt;each recommendation" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF3EB;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;fontColor=#1B3A1D;verticalAlign=middle;align=center;" vertex="1" parent="1">
