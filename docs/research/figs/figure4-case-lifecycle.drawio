        </mxCell>
        <mxCell id="note-tl" value="only a human confirm or modify adds the &quot;action taken&quot; step" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#5F6368;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="320" y="492" width="560" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend4" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;blue = case state&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;green = action a human officer takes&amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp;purple = the only path that reaches the complainant" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#5F6368;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="840" height="24" as="geometry" />
