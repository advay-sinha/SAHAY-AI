<mxfile host="app.diagrams.net" agent="SAHAY-AI whole-deck report" version="24.7.17">
  <diagram id="sahay-fig4" name="Figure 4 - Case lifecycle">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ titles ============ -->
        <mxCell id="zone-state" value="CASE STATE - every transition after the first is a human action" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#1F4E79;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="36" width="620" height="24" as="geometry" />
        </mxCell>
        <mxCell id="zone-actions" value="OFFICER ACTIONS - executive tokens only; a supervisor token is read-only and gets 403" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#2E7D32;letterSpacing=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="212" width="760" height="24" as="geometry" />
