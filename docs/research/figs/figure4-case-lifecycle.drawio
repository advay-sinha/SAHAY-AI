        <!-- ============ victim-safe timeline ============ -->
        <mxCell id="tl" value="&lt;b&gt;victim-safe timeline&lt;/b&gt;&lt;br&gt;request received&amp;nbsp;&amp;rarr; under review &amp;rarr; officer assigned &amp;rarr; action taken &amp;rarr; follow-up scheduled &amp;rarr; closed&lt;br&gt;plain language, no pathway, no score" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1ECF7;strokeColor=#6A3D9A;strokeWidth=1.5;fontSize=10;fontColor=#3E2360;verticalAlign=middle;align=center;" vertex="1" parent="1">
