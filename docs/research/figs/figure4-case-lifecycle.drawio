          <mxGeometry x="590" y="250" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;officer message&lt;/b&gt;&lt;br&gt;to the complainant" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF3EB;strokeColor=#2E7D32;strokeWidth=1.5;fontSize=10;fontColor=#1B3A1D;verticalAlign=middle;align=center;" vertex="1" parent="1">
